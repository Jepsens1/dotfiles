{
	"include": [
		"~/.config/waybar/modules/modules.jsonc",
		"~/.config/waybar/modules/custom-modules.jsonc"
	],

	"layer": "top",
	"margin-top": 7,

	"modules-left": [
		"custom/launcher",
		"hyprland/workspaces"
	],

	"modules-center": [
		"custom/notification",
		"clock",
		"custom/media"
	],

	"modules-right": [
		"custom/yay",
		"cpu",
		"wireplumber",
		"battery",
		"power-profiles-daemon",
		"network",
		"tray"
	]
}